<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>io.descoped.stride.application</groupId>
    <artifactId>stride-application-project</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Stride Application Project</name>
    <description>Stride Application Project</description>
    <url>https://github.com/descoped/stride-application-project</url>
    <inceptionYear>2023</inceptionYear>

    <modules>
        <module>stride-application-parent</module>
        <module>stride-application-config</module>
        <module>stride-application-api</module>
        <module>stride-application-junit5</module>
        <module>stride-application-core</module>
        <module>stride-application-openapi</module>
        <module>stride-application-security</module>
        <module>stride-application-sample</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- One SonarCloud project for the whole repository. The scanner analyses every module in one run, and it
             runs only in the last project of the build, which is this one: so the profile and its settings are
             here and not in the parent POM. Coverage comes from each module's target/site/jacoco/jacoco.xml
             (profile `coverage`). -->
        <profile>
            <id>sonar</id>
            <properties>
                <sonar.host.url>https://sonarcloud.io</sonar.host.url>
                <sonar.organization>descoped</sonar.organization>
                <sonar.projectKey>descoped_stride-application-project</sonar.projectKey>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonarsource.scanner.maven</groupId>
                        <artifactId>sonar-maven-plugin</artifactId>
                        <version>5.9.0.7382</version>
                        <executions>
                            <execution>
                                <id>sonar</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sonar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
