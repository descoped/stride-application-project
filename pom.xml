<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>io.descoped.stride.application</groupId>
    <artifactId>stride-application-project</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Stride Application Project</name>
    <description>Stride Application Project</description>
    <url>https://github.com/descoped/stride-application-project</url>
    <inceptionYear>2023</inceptionYear>

    <modules>
        <module>stride-application-parent</module>
        <module>stride-application-config</module>
        <module>stride-application-api</module>
        <module>stride-application-junit-jupiter</module>
        <module>stride-application-core</module>
        <module>stride-application-openapi</module>
        <module>stride-application-security</module>
        <module>stride-application-sample</module>
    </modules>

    <!-- A release is run here, and the release plugin needs to know the repository. This POM inherits nothing
         from stride-application-parent, so it is said again. -->
    <scm>
        <connection>scm:git:git://github.com/descoped/stride-application-project.git</connection>
        <developerConnection>scm:git:git@github.com:descoped/stride-application-project.git</developerConnection>
        <url>https://github.com/descoped/stride-application-project</url>
        <tag>HEAD</tag>
    </scm>

    <build>
        <plugins>
            <!-- Release (by hand, never from CI): mvn release:prepare release:perform -P central,sign,secrets
                 See the `central` profile in stride-application-parent/pom.xml. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <tagNameFormat>v@{project.version}</tagNameFormat>
                    <autoVersionSubmodules>true</autoVersionSubmodules>
                    <releaseProfiles>central,sign</releaseProfiles>
                    <goals>deploy</goals>
                    <!-- The sample application is an example, never an artifact: it is left out of the builds
                         the release runs. That includes the verify before the tag; pull request and master
                         builds test the sample. The sample's own POM fails any build that has both the sample
                         and the central profile. -->
                    <arguments>-pl !:stride-application-sample</arguments>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- One SonarCloud project for the whole repository. The scanner analyses every module in one run, and it
             runs only in the last project of the build, which is this one: so the profile and its settings are
             here and not in the parent POM. Coverage comes from each module's target/site/jacoco/jacoco.xml
             (profile `coverage`). -->
        <profile>
            <id>sonar</id>
            <properties>
                <sonar.version>5.9.0.7382</sonar.version>
                <sonar.host.url>https://sonarcloud.io</sonar.host.url>
                <sonar.organization>descoped</sonar.organization>
                <sonar.projectKey>descoped_stride-application-project</sonar.projectKey>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonarsource.scanner.maven</groupId>
                        <artifactId>sonar-maven-plugin</artifactId>
                        <version>${sonar.version}</version>
                        <executions>
                            <execution>
                                <id>sonar</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sonar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
