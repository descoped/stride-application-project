{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "packageRules": [
    {
      "description": "Always the latest stable version; CI is the gate",
      "matchManagers": [
        "maven",
        "github-actions"
      ],
      "automerge": true
    },
    {
      "description": "JDK versions in the workflows are deliberate: CI and `respond` build on the Java 21 baseline. They are changed by hand, never bumped.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "java-jdk"
      ],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "automerge": true
  }
}
