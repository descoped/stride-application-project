<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.descoped.stride.application</groupId>
        <artifactId>stride-application-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../stride-application-parent</relativePath>
    </parent>

    <!-- A small application built on Stride, kept working by the build. It is an example, not a library: the
         builds that publish leave this module out (see the central profile and the release plugin in the parent),
         and the central profile below fails a build that does not. -->
    <artifactId>stride-application-sample</artifactId>
    <packaging>jar</packaging>

    <properties>
        <sonar.skip>true</sonar.skip>
    </properties>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <dependencies>
        <!-- The runtime: server, lifecycle, REST. It brings the configuration and API modules. -->
        <dependency>
            <groupId>io.descoped.stride.application</groupId>
            <artifactId>stride-application-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Stride logs through SLF4J and ships no backend: the application picks one. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>

        <dependency>
            <groupId>io.descoped.stride.application</groupId>
            <artifactId>stride-application-junit-jupiter</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- The publishing profile of the parent uploads the whole reactor in one go, at the end of the build.
             Failing here in the first phase means this module never reaches deploy, and the build stops before
             anything is uploaded. -->
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sample-is-never-published</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <alwaysFail>
                                            <message>The sample application is never published. Add -pl '!:stride-application-sample' to a build that uses the central profile.</message>
                                        </alwaysFail>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
